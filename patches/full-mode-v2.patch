+func TestV2SessionReuseRetryRestartAndBranches(t *testing.T) {
+	oldCfg, oldBase := AppConfig, NotionAPIBase
+	AppConfig = DefaultConfig()
+	defer func() { AppConfig, NotionAPIBase = oldCfg, oldBase }()
+	t.Setenv("NOTION_AGENT_SESSION_DIR", t.TempDir())
+	created, sent, polls := 0, 0, 0
+	turn := 0
+	var sendContent string
+	stale := false
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]interface{}
+		json.NewDecoder(r.Body).Decode(&body)
+		switch filepath.Base(r.URL.Path) {
+		case "createAgentThread":
+			created++
+			turn++
+			id := body["threadId"]
+			json.NewEncoder(w).Encode(map[string]interface{}{"threadId": id, "thread": map[string]interface{}{"id": id, "data": map[string]interface{}{"agent_provider": map[string]string{"model": "fixed", "selectedModel": "fixed"}}}})
+		case "sendEventToAgentThread":
+			sent++
+			turn++
+			event := body["event"].(map[string]interface{})
+			if event["type"] != "user.message" || body["model"] != "fixed" || body["clientEventId"] == "" {
+				t.Error("invalid continuation contract")
+			}
+			encoded, _ := json.Marshal(event["content"])
+			sendContent = string(encoded)
+			stale = true
+			w.Write([]byte(`{}`))
+		case "getThreadTranscript":
+			polls++
+			n := turn
+			if stale {
+				n--
+				stale = false
+			}
+			fmt.Fprintf(w, `{"type":"agent_service_transcript_page","session":{"status":"idle"},"has_more_backward":true,"has_more_forward":false,"patches":[{"op":"put","entity":{"id":"a%d","kind":"assistant_message","sequence":%d,"content":[{"type":"text","text":"answer%d"}]}},{"op":"put","entity":{"id":"done%d","kind":"turn_completed","sequence":%d,"stop_reason":"end_turn"}}]}`, n, n*10-1, n, n, n*10)
+		default:
+			t.Error("unexpected endpoint")
+		}
+	}))
+	defer server.Close()
+	NotionAPIBase = server.URL
+	acc := &Account{UserEmail: "local-test", SpaceID: "space"}
+	first := []ChatMessage{{Role: "system", Content: "x-anthropic-billing-header: nonce=first\nnative instructions"}, {Role: "user", Content: "first request UNIQUE-FIRST"}}
+	call := func(m []ChatMessage) (string, error) {
+		s := ""
+		e := callAgentSession(acc, m, "claude-opus-5-5", "fixed", "session-A", func(x string, _ bool, _ *UsageInfo) { s += x }, server.Client())
+		return s, e
+	}
+	if s, e := call(first); e != nil || s != "answer1" {
+		t.Fatalf("first: %q %v", s, e)
+	}
+	previousPolls := polls
+	// A fresh in-memory lock registry simulates process restart; state is on disk.
+	agentSessionLocks = sync.Map{}
+	if s, e := call(first); e != nil || s != "answer1" {
+		t.Fatalf("retry: %q %v", s, e)
+	}
+	if polls != previousPolls {
+		t.Fatal("completed retry reached upstream")
+	}
+	second := append(cloneChatMessages(first), ChatMessage{Role: "assistant", Content: "answer1"}, ChatMessage{Role: "user", Content: "second request UNIQUE-SECOND"})
+	second[0].Content = "x-anthropic-billing-header: nonce=second\nnative instructions"
+	if s, e := call(second); e != nil || s != "answer2" {
+		t.Fatalf("second returned stale or concatenated output: %q %v", s, e)
+	}
+	if created != 1 || sent != 1 {
+		t.Fatalf("created=%d continued=%d", created, sent)
+	}
+	if strings.Contains(sendContent, "UNIQUE-FIRST") || !strings.Contains(sendContent, "UNIQUE-SECOND") {
+		t.Fatal("continuation did not send only new messages")
+	}
+	if strings.Contains(sendContent, "native instructions") {
+		t.Fatal("billing marker caused unchanged system instructions to be resent")
+	}
+	branch := cloneChatMessages(second)
+	branch[1].Content = "changed original"
+	if _, e := call(branch); e == nil {
+		t.Fatal("divergent history accepted")
+	}
+	if created != 1 || sent != 1 {
+		t.Fatal("branch unexpectedly mutated upstream")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if _, e := call(second); e != nil {
+				t.Error(e)
+			}
+		}()
+	}
+	wg.Wait()
+	if created != 1 || sent != 1 {
+		t.Fatal("parallel retry generated duplicate turn")
+	}
+	if err := callAgentSession(&Account{UserEmail: "other", SpaceID: "space"}, second, "alias", "fixed", "session-A", func(string, bool, *UsageInfo) {}, server.Client()); err == nil {
+		t.Fatal("cross-account continuation accepted")
+	}
+}

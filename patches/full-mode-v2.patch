diff --git a/internal/proxy/agent_session_v2.go b/internal/proxy/agent_session_v2.go
new file mode 100644
--- /dev/null
+++ b/internal/proxy/agent_session_v2.go
@@ -0,0 +1,435 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+)
+
+// V2 is explicitly enabled per process, leaving the existing gateway unchanged.
+func agentSessionEnabled() bool { return os.Getenv("NOTION_AGENT_SESSION_DIR") != "" }
+
+func agentHash(v interface{}) string {
+	b, _ := json.Marshal(v)
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+
+// Keep parent and child tasks separate even when CC shares metadata.session_id.
+func agentSessionFingerprint(messages []ChatMessage, salt, model string) string {
+	first := ""
+	for _, m := range messages {
+		if isMeaningfulUserMessage(m) {
+			first = normalizeSessionUserContent(m.Content)
+			break
+		}
+	}
+	return agentHash([]string{salt, model, first})
+}
+
+type agentPending struct {
+	Hash       string
+	EventID    string
+	Baseline   float64
+	Attempted  bool
+	Accepted   bool
+	History    []string
+	SystemHash string
+	SystemSeen []string
+}
+type agentSessionState struct {
+	Version           int
+	ThreadID          string
+	Account           string
+	Model             string
+	Confirmed         bool
+	Sequence          float64
+	History           []string
+	SystemHash        string
+	SystemSeen        []string
+	LastHash          string
+	Answer            string
+	Pending           *agentPending
+	SchemaRequestHash string
+	SchemaRounds      int
+}
+
+var agentSessionLocks sync.Map
+
+func saveAgentState(path string, state *agentSessionState) error {
+	b, err := json.MarshalIndent(state, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".agent-session-*.tmp")
+	if err != nil {
+		return err
+	}
+	temp := f.Name()
+	defer os.Remove(temp)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(b)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return os.Rename(temp, path)
+}
+
+func agentRequestParts(messages []ChatMessage) (history []string, systemHash string, nonSystem []ChatMessage) {
+	var system []ChatMessage
+	for _, m := range messages {
+		if m.Role == "system" {
+			m.Content = normalizeSessionSystemContent(m.Content)
+			system = append(system, m)
+		} else {
+			nonSystem = append(nonSystem, m)
+			history = append(history, agentHash(m))
+		}
+	}
+	return history, agentHash(system), nonSystem
+}
+
+func agentSystemDelta(messages []ChatMessage, previous []string) ([]ChatMessage, []string) {
+	seen := make(map[string]bool)
+	all := append([]string(nil), previous...)
+	for _, h := range previous {
+		seen[h] = true
+	}
+	var delta []ChatMessage
+	for _, m := range messages {
+		if m.Role != "system" {
+			continue
+		}
+		normalized := m
+		normalized.Content = normalizeSessionSystemContent(m.Content)
+		h := agentHash(normalized)
+		if !seen[h] {
+			delta = append(delta, m)
+			all = append(all, h)
+			seen[h] = true
+		}
+	}
+	return delta, all
+}
+
+type agentHTTPError struct {
+	Status   int
+	Endpoint string
+}
+
+func (e *agentHTTPError) Error() string {
+	return fmt.Sprintf("Agent %s HTTP %d; pending event retained", e.Endpoint, e.Status)
+}
+
+// Parse only events after the previous completed turn. Old idle/end_turn events
+// cannot satisfy a new inference, and old answers cannot leak into its output.
+func readAgentTranscriptAfter(page agentTranscriptPage, after float64) (string, bool, float64, error) {
+	if page.HasMoreForward {
+		return "", false, after, fmt.Errorf("new Agent turn exceeds one page; refusing truncated output")
+	}
+	filtered := page
+	filtered.Patches = nil
+	filtered.HasMoreBackward = false // forward query intentionally excludes older turns
+	seq := after
+	for _, p := range page.Patches {
+		if p.Op == "put" && p.Entity.Sequence > after {
+			filtered.Patches = append(filtered.Patches, p)
+			if p.Entity.Sequence > seq {
+				seq = p.Entity.Sequence
+			}
+		}
+	}
+	text, done, err := readAgentTranscript(filtered)
+	return text, done, seq, err
+}
+
+func pollAgentPending(ctx context.Context, post func(string, interface{}, interface{}) error, acc *Account, state *agentSessionState, path string) (string, error) {
+	pending := state.Pending
+	if pending == nil || !state.Confirmed {
+		return "", fmt.Errorf("unconfirmed Agent create; no replacement conversation created")
+	}
+	query := map[string]interface{}{"spaceId": acc.SpaceID, "threadId": state.ThreadID, "direction": "forward", "afterSequence": pending.Baseline, "limit": 100}
+	for {
+		var page agentTranscriptPage
+		if err := post("getThreadTranscript", query, &page); err != nil {
+			return "", err
+		}
+		text, done, seq, err := readAgentTranscriptAfter(page, pending.Baseline)
+		if err != nil {
+			return "", err
+		}
+		if done {
+			if strings.TrimSpace(text) == "" {
+				return "", ErrEmptyResponse
+			}
+			state.Sequence, state.History, state.SystemHash = seq, pending.History, pending.SystemHash
+			state.SystemSeen = pending.SystemSeen
+			state.LastHash, state.Answer, state.Pending = pending.Hash, text, nil
+			if err = saveAgentState(path, state); err != nil {
+				return "", err
+			}
+			log.Printf("[agent-v2] completed requested=%s thread_sha256=%s sequence=%.1f", state.Model, agentHash(state.ThreadID), seq)
+			return text, nil
+		}
+		timer := time.NewTimer(500 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return "", fmt.Errorf("Agent inference deadline; event retained for resume: %w", ctx.Err())
+		case <-timer.C:
+		}
+	}
+}
+
+func callAgentSession(acc *Account, messages []ChatMessage, alias, model, key string, cb StreamCallback, client *http.Client, toolRegistry ...[]Tool) error {
+	if key == "" {
+		return fmt.Errorf("persistent Agent transport requires a conversation key")
+	}
+	if model == "" {
+		return fmt.Errorf("persistent Agent transport requires an explicit confirmed model")
+	}
+	dir := os.Getenv("NOTION_AGENT_SESSION_DIR")
+	path := filepath.Join(dir, agentHash(key)+".json")
+	lock, _ := agentSessionLocks.LoadOrStore(path, &sync.Mutex{})
+	mu := lock.(*sync.Mutex)
+	mu.Lock()
+	defer mu.Unlock()
+	owner := agentHash([]string{acc.UserID, acc.UserEmail, acc.SpaceID})
+	state := agentSessionState{Version: 1, Account: owner, Model: model}
+	b, err := os.ReadFile(path)
+	if err == nil {
+		if json.Unmarshal(b, &state) != nil || state.Version != 1 || state.ThreadID == "" {
+			return fmt.Errorf("invalid persisted Agent state; refusing replacement thread")
+		}
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("cannot read persisted Agent state")
+	}
+	if state.Account != owner || state.Model != model {
+		return fmt.Errorf("Agent conversation is bound to another account/workspace/model; refusing silent reroute")
+	}
+	requestHash := agentHash(messages)
+	var tools []Tool
+	if len(toolRegistry) > 0 {
+		tools = toolRegistry[0]
+	}
+	if state.SchemaRequestHash != requestHash {
+		state.SchemaRequestHash = requestHash
+		state.SchemaRounds = 0
+	}
+	history, systemHash, nonSystem := agentRequestParts(messages)
+	timeout := AppConfig.InferenceTimeoutDuration()
+	if timeout <= 0 {
+		return fmt.Errorf("Agent inference timeout must be positive")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	post := func(endpoint string, body, result interface{}) error {
+		data, e := json.Marshal(body)
+		if e != nil {
+			return e
+		}
+		req, e := http.NewRequestWithContext(ctx, "POST", strings.TrimRight(NotionAPIBase, "/")+"/"+endpoint, bytes.NewReader(data))
+		if e != nil {
+			return e
+		}
+		setNotionHeadersJSON(req, acc)
+		resp, e := client.Do(req)
+		if e != nil {
+			return fmt.Errorf("Agent %s: %w", endpoint, e)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != 200 {
+			return &agentHTTPError{Status: resp.StatusCode, Endpoint: endpoint}
+		}
+		rd, cleanup, e := decompressBody(resp)
+		if e != nil {
+			return e
+		}
+		if cleanup != nil {
+			defer cleanup()
+		}
+		if result == nil {
+			_, e = io.Copy(io.Discard, io.LimitReader(rd, 8<<20))
+			return e
+		}
+		if e = json.NewDecoder(io.LimitReader(rd, 8<<20)).Decode(result); e != nil {
+			return fmt.Errorf("invalid Agent %s response: %w", endpoint, e)
+		}
+		return nil
+	}
+	resolveSchemas := func(answer string) (string, error) {
+		for {
+			name, isSchema := agentRequestedSchema(answer)
+			if !isSchema {
+				return answer, nil
+			}
+			if state.SchemaRounds >= 8 {
+				return "", fmt.Errorf("action-schema resolution budget exhausted")
+			}
+			text, e := agentExactSchema(tools, name)
+			if e != nil {
+				return "", e
+			}
+			state.SchemaRounds++
+			state.Pending = &agentPending{Hash: requestHash, EventID: generateUUIDv4(), Baseline: state.Sequence, Attempted: true, History: state.History, SystemHash: state.SystemHash, SystemSeen: state.SystemSeen}
+			if e = saveAgentState(path, &state); e != nil {
+				return "", e
+			}
+			body := map[string]interface{}{"spaceId": acc.SpaceID, "threadId": state.ThreadID, "clientEventId": state.Pending.EventID, "model": model, "reasoningEffort": "medium", "browserEnabled": false, "policies": map[string]string{"approval_mode": "ask"}, "event": map[string]interface{}{"type": "user.message", "content": []interface{}{map[string]interface{}{"type": "text", "text": [][]string{{text}}}}}}
+			if e = post("sendEventToAgentThread", body, nil); e != nil {
+				return "", e
+			}
+			state.Pending.Accepted = true
+			if e = saveAgentState(path, &state); e != nil {
+				return "", e
+			}
+			log.Printf("[agent-v2] exact_schema_supplied action=%s thread_sha256=%s", name, agentHash(state.ThreadID))
+			answer, e = pollAgentPending(ctx, post, acc, &state, path)
+			if e != nil {
+				return "", e
+			}
+		}
+	}
+	if state.Pending == nil && state.LastHash == requestHash {
+		answer, e := resolveSchemas(state.Answer)
+		if e != nil {
+			return e
+		}
+		cb(answer, false, nil)
+		cb("", true, nil)
+		return nil
+	}
+	if state.Pending != nil && state.Pending.Hash != requestHash {
+		if len(history) < len(state.Pending.History) {
+			return fmt.Errorf("unresolved Agent request conflicts with a rolled-back history")
+		}
+		for i, h := range state.Pending.History {
+			if history[i] != h {
+				return fmt.Errorf("unresolved Agent request belongs to another conversation branch")
+			}
+		}
+		// Reconcile a response lost during client disconnect before appending the
+		// newly resumed turn. Neither the accepted event nor the chat is duplicated.
+		if _, err = pollAgentPending(ctx, post, acc, &state, path); err != nil {
+			return err
+		}
+	}
+	if state.Pending == nil && state.LastHash != "" && len(history) == len(state.History) && systemHash == state.SystemHash {
+		equal := true
+		for i, h := range history {
+			if state.History[i] != h {
+				equal = false
+				break
+			}
+		}
+		if equal {
+			answer, e := resolveSchemas(state.Answer)
+			if e != nil {
+				return e
+			}
+			cb(answer, false, nil)
+			cb("", true, nil)
+			return nil
+		}
+	}
+	if state.Pending == nil {
+		if len(history) < len(state.History) {
+			return fmt.Errorf("Agent history rollback requires an explicit branch; refusing another thread")
+		}
+		for i, h := range state.History {
+			if history[i] != h {
+				return fmt.Errorf("Agent history diverged; refusing to mix conversation branches")
+			}
+		}
+		if state.ThreadID == "" {
+			state.ThreadID = generateUUIDv4()
+		}
+		_, allSystems := agentSystemDelta(messages, state.SystemSeen)
+		state.Pending = &agentPending{Hash: requestHash, EventID: generateUUIDv4(), Baseline: state.Sequence, History: history, SystemHash: systemHash, SystemSeen: allSystems}
+		if err = saveAgentState(path, &state); err != nil {
+			return err
+		}
+	}
+	pending := state.Pending
+	if !pending.Attempted {
+		pending.Attempted = true
+		if err = saveAgentState(path, &state); err != nil {
+			return err
+		}
+		if !state.Confirmed {
+			body := agentThreadBody(acc, messages)
+			body["threadId"], body["clientMessageId"] = state.ThreadID, pending.EventID
+			body["model"], body["reasoningEffort"] = model, "medium"
+			var created agentCreateResponse
+			if err = post("createAgentThread", body, &created); err != nil {
+				return err
+			}
+			if err = verifyAgentModelConfirmation(created, model, state.ThreadID); err != nil {
+				return err
+			}
+			state.Confirmed = true
+			log.Printf("[agent-v2] created alias=%s requested=%s confirmed=%s selected=%s thread_sha256=%s", alias, model, created.Thread.Data.AgentProvider.Model, created.Thread.Data.AgentProvider.SelectedModel, agentHash(state.ThreadID))
+		} else {
+			delta := append([]ChatMessage(nil), nonSystem[len(state.History):]...)
+			changed, _ := agentSystemDelta(messages, state.SystemSeen)
+			delta = append(changed, delta...)
+			content := []interface{}{map[string]interface{}{"type": "text", "text": [][]string{{agentThreadPrompt(delta)}}}}
+			body := map[string]interface{}{"spaceId": acc.SpaceID, "threadId": state.ThreadID, "clientEventId": pending.EventID,
+				"event": map[string]interface{}{"type": "user.message", "content": content}, "model": model, "reasoningEffort": "medium",
+				"browserEnabled": false, "policies": map[string]string{"approval_mode": "ask"}}
+			log.Printf("[agent-v2] submitting delta_bytes=%d system_changed=%v", len(agentThreadPrompt(delta)), systemHash != state.SystemHash)
+			if err = post("sendEventToAgentThread", body, nil); err != nil {
+				if response, ok := err.(*agentHTTPError); ok && (response.Status == 400 || response.Status == 413 || response.Status == 422) {
+					// A definite validation rejection did not enqueue the turn.
+					// Retain the thread; a corrected request may continue its history.
+					state.Pending = nil
+					if saveErr := saveAgentState(path, &state); saveErr != nil {
+						return saveErr
+					}
+				}
+				return err
+			}
+			log.Printf("[agent-v2] continued requested=%s thread_sha256=%s delta_messages=%d", model, agentHash(state.ThreadID), len(delta))
+		}
+		pending.Accepted = true
+		if err = saveAgentState(path, &state); err != nil {
+			return err
+		}
+	}
+	if !state.Confirmed {
+		return fmt.Errorf("Agent create outcome is ambiguous; persisted thread retained, no duplicate created")
+	}
+	text, err := pollAgentPending(ctx, post, acc, &state, path)
+	if err != nil {
+		return err
+	}
+	text, err = resolveSchemas(text)
+	if err != nil {
+		return err
+	}
+	cb(text, false, nil)
+	cb("", true, nil)
+	return nil
+}

+++ b/internal/proxy/agent_catalog_v2.go
@@ -0,0 +1,65 @@
+package proxy
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+const agentSchemaAction = "__notion_get_action_schema"
+
+// Claude Code may load hundreds of MCP schemas asynchronously. Keep every
+// action discoverable, and provide its exact unmodified schema on demand.
+// Only the adapter handles this read-only action; CC still executes real tools.
+func buildAgentActionCatalog(tools []Tool) string {
+	var inline []Tool
+	var catalog strings.Builder
+	for _, tool := range tools {
+		if !strings.HasPrefix(tool.Function.Name, "mcp__") {
+			inline = append(inline, tool)
+			continue
+		}
+		description := strings.Join(strings.Fields(tool.Function.Description), " ")
+		runes := []rune(description)
+		if len(runes) > 72 {
+			description = string(runes[:72]) + "…"
+		}
+		fmt.Fprintf(&catalog, "%s: %s\n", tool.Function.Name, description)
+	}
+	prompt := buildOpenAIToolsBlock(inline)
+	if catalog.Len() > 0 {
+		prompt += "\nAdditional available local MCP actions (all remain available):\n" + catalog.String()
+		prompt += "\nBefore first calling an action from this additional catalog, request its exact schema with the read-only adapter action {\"name\":\"" + agentSchemaAction + "\",\"arguments\":{\"name\":\"exact_action_name\"}}. The adapter will return its complete description and input schema. Then request the real action using that schema. Never invent arguments; do not execute the action in Notion's hosted tools. Previously supplied unchanged schemas remain valid.\n"
+	}
+	return prompt
+}
+
+func agentRequestedSchema(text string) (string, bool) {
+	text = strings.TrimSpace(text)
+	text = strings.TrimPrefix(text, "```json")
+	text = strings.TrimPrefix(text, "```")
+	text = strings.TrimSuffix(text, "```")
+	var request struct {
+		Name      string `json:"name"`
+		Arguments struct {
+			Name string `json:"name"`
+		} `json:"arguments"`
+	}
+	if json.Unmarshal([]byte(strings.TrimSpace(text)), &request) != nil || request.Name != agentSchemaAction {
+		return "", false
+	}
+	return request.Arguments.Name, true
+}
+
+func agentExactSchema(tools []Tool, name string) (string, error) {
+	for _, tool := range tools {
+		if tool.Function.Name == name {
+			b, err := json.Marshal(map[string]interface{}{"name": name, "description": tool.Function.Description, "input_schema": tool.Function.Parameters})
+			if err != nil {
+				return "", err
+			}
+			return "READ-ONLY ACTION SCHEMA RESULT\n" + string(b) + "\nNow continue the user's task. Request the real local action with its exact schema; the local client will execute it and return a result.", nil
+		}
+	}
+	return "", fmt.Errorf("requested action schema is not in the current Claude Code tool registry")
+}

new file mode 100644
index 0000000..0ad48a6
--- /dev/null
+++ b/internal/proxy/agent_model.go
@@ -0,0 +1,66 @@
+package proxy
+
+import (
+	"fmt"
+	"strings"
+)
+
+var agentModelFetcher = FetchModels
+
+// Opus resolves from this account's fresh listing, never a legacy family fallback.
+func resolveAgentModel(acc *Account, model string) (string, error) {
+	switch strings.ToLower(strings.TrimSpace(model)) {
+	case "auto":
+		if AppConfig != nil && AppConfig.Proxy.RequireOpus55 {
+			return "", fmt.Errorf("this installation is locked to Opus 5.5; Auto is prohibited")
+		}
+		return "", nil
+	case "opus-5.5", "claude-opus-5-5", "claude-opus-5.5":
+	default:
+		return "", fmt.Errorf("unsupported Notion Agent model %q; no model fallback is permitted", model)
+	}
+	models, err := agentModelFetcher(acc)
+	if err != nil {
+		return "", fmt.Errorf("cannot verify the account's current available Opus 5.5 model")
+	}
+	selected := ""
+	for _, entry := range models {
+		if normalizeModelName(entry.Name) == "opus-5.5" {
+			if entry.ID == "" || selected != "" {
+				return "", fmt.Errorf("Opus 5.5 model listing is empty or ambiguous")
+			}
+			selected = entry.ID
+		}
+	}
+	if selected == "" {
+		return "", fmt.Errorf("Opus 5.5 is unavailable for this account; refusing Auto fallback")
+	}
+	return selected, nil
+}
+
+// Shape captured by the explicit live probe on 2026-10-14. Missing fields fail closed.
+type agentCreateResponse struct {
+	ThreadID string `json:"threadId"`
+	Thread   struct {
+		ID   string `json:"id"`
+		Data struct {
+			AgentProvider struct {
+				Model         string `json:"model"`
+				SelectedModel string `json:"selectedModel"`
+			} `json:"agent_provider"`
+		} `json:"data"`
+	} `json:"thread"`
+}
+
+func verifyAgentModelConfirmation(created agentCreateResponse, requested, threadID string) error {
+	provider := created.Thread.Data.AgentProvider
+	if created.ThreadID != threadID || created.Thread.ID != threadID {
+		return fmt.Errorf("Notion model confirmation belongs to a missing or different thread")
+	}
+	if provider.Model == "" || provider.SelectedModel == "" ||
+		provider.Model != requested || provider.SelectedModel != requested {
+		return fmt.Errorf("Notion model confirmation mismatch: requested=%s confirmed=%s selected=%s; refusing fallback",
+			requested, provider.Model, provider.SelectedModel)
+	}
+	return nil
+}
diff --git a/internal/proxy/agent_model_test.go b/internal/proxy/agent_model_test.go
new file mode 100644
index 0000000..f7779f4
--- /dev/null
+++ b/internal/proxy/agent_model_test.go
@@ -0,0 +1,126 @@
+package proxy
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestAgentFixedModelFreshExactListing(t *testing.T) {
+	original := agentModelFetcher
+	defer func() { agentModelFetcher = original }()
+	queried := 0
+	agentModelFetcher = func(*Account) ([]ModelEntry, error) {
+		queried++
+		return []ModelEntry{{Name: "Opus 4.6", ID: "old"}, {Name: "Opus 5.5", ID: "current-live-id"}}, nil
+	}
+	for _, name := range []string{"opus-5.5", "claude-opus-5-5", "claude-opus-5.5"} {
+		actual, err := resolveAgentModel(&Account{}, name)
+		if err != nil || actual != "current-live-id" {
+			t.Fatalf("exact selection failed: %q %v", actual, err)
+		}
+	}
+	if queried != 3 {
+		t.Fatal("model list was not checked for every fixed-model request")
+	}
+	if id, err := resolveAgentModel(&Account{}, "auto"); err != nil || id != "" || queried != 3 {
+		t.Fatal("Auto changed")
+	}
+	if _, err := resolveAgentModel(&Account{}, "claude-opus-4-6"); err == nil || queried != 3 {
+		t.Fatal("unknown model silently selected another model")
+	}
+	agentModelFetcher = func(*Account) ([]ModelEntry, error) { return []ModelEntry{{Name: "Opus 4.6", ID: "old"}}, nil }
+	if _, err := resolveAgentModel(&Account{}, "claude-opus-5-5"); err == nil {
+		t.Fatal("unavailable model fell back")
+	}
+	agentModelFetcher = func(*Account) ([]ModelEntry, error) {
+		return []ModelEntry{{Name: "Opus 5.5", ID: "a"}, {Name: "Opus 5.5", ID: "b"}}, nil
+	}
+	if _, err := resolveAgentModel(&Account{}, "claude-opus-5-5"); err == nil {
+		t.Fatal("ambiguous listing accepted")
+	}
+}
+
+func confirmedCreate(thread, model, selected string) agentCreateResponse {
+	var created agentCreateResponse
+	created.ThreadID = thread
+	created.Thread.ID = thread
+	created.Thread.Data.AgentProvider.Model = model
+	created.Thread.Data.AgentProvider.SelectedModel = selected
+	return created
+}
+
+func TestAgentFixedModelConfirmationFailsClosed(t *testing.T) {
+	for _, created := range []agentCreateResponse{
+		confirmedCreate("thread", "wanted", "wanted"),
+		confirmedCreate("other", "wanted", "wanted"),
+		confirmedCreate("thread", "other", "wanted"),
+		confirmedCreate("thread", "wanted", "other"),
+		confirmedCreate("thread", "", "wanted"),
+		confirmedCreate("thread", "wanted", ""),
+	} {
+		err := verifyAgentModelConfirmation(created, "wanted", "thread")
+		wantSuccess := created.ThreadID == "thread" && created.Thread.Data.AgentProvider.Model == "wanted" && created.Thread.Data.AgentProvider.SelectedModel == "wanted"
+		if (err == nil) != wantSuccess {
+			t.Fatalf("confirmation mismatch was accepted: %+v", created)
+		}
+	}
+}
+
+func TestAgentFixedModelLockRejectsAuto(t *testing.T) {
+	previous := AppConfig
+	AppConfig = DefaultConfig()
+	AppConfig.Proxy.RequireOpus55 = true
+	defer func() { AppConfig = previous }()
+	if _, err := resolveAgentModel(&Account{}, "auto"); err == nil {
+		t.Fatal("fixed installation permitted Auto")
+	}
+}
+
+func TestAgentFixedModelTransportConfirmedBeforeOutput(t *testing.T) {
+	oldCfg, oldBase := AppConfig, NotionAPIBase
+	AppConfig = DefaultConfig()
+	AppConfig.Timeouts.InferenceTimeout = 2
+	defer func() { AppConfig, NotionAPIBase = oldCfg, oldBase }()
+	selected := "wanted"
+	polled := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "createAgentThread") {
+			var body map[string]interface{}
+			json.NewDecoder(r.Body).Decode(&body)
+			if body["model"] != "wanted" {
+				t.Error("fixed upstream ID omitted")
+			}
+			json.NewEncoder(w).Encode(confirmedCreate(body["threadId"].(string), "wanted", selected))
+		} else {
+			polled++
+			w.Write([]byte(capturedShape))
+		}
+	}))
+	defer server.Close()
+	NotionAPIBase = server.URL
+	output := false
+	err := callAgentThreadWithSelection(&Account{}, nil, "claude-opus-5-5", "wanted", func(string, bool, *UsageInfo) { output = true }, server.Client())
+	if err != nil || !output || polled == 0 {
+		t.Fatalf("confirmed transport failed: %v", err)
+	}
+	output, polled, selected = false, 0, "wrong"
+	err = callAgentThreadWithSelection(&Account{}, nil, "claude-opus-5-5", "wanted", func(string, bool, *UsageInfo) { output = true }, server.Client())
+	if err == nil || output || polled != 0 {
+		t.Fatal("unconfirmed output or transcript was exposed")
+	}
+}
+
+func TestAgentFixedModelPreservesLocalToolProtocol(t *testing.T) {
+	oldCfg := AppConfig
+	AppConfig = DefaultConfig()
+	AppConfig.Proxy.AgentThread = true
+	defer func() { AppConfig = oldCfg }()
+	tools := []Tool{{Function: ToolFunction{Name: "Read", Parameters: map[string]interface{}{"type": "object"}}}}
+	messages := injectToolsIntoMessages([]ChatMessage{{Role: "user", Content: "read test file"}}, tools, "claude-opus-5-5", nil)
+	if !strings.Contains(messages[0].Content, "LOCAL ACTION PROTOCOL") || !strings.Contains(messages[0].Content, "Read") {
+		t.Fatal("fixed model fell through to the legacy tool bridge")
+	}
+}
